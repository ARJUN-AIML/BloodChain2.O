# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-key-bloodchain-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Neon PostgreSQL)
# Example: postgresql://user:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# Firebase Authentication Configuration
FIREBASE_PROJECT_ID=bloodchain-demo
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@bloodchain-demo.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nEXAMPLE_KEY\n-----END PRIVATE KEY-----\n"

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
