# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-key-bloodchain-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Neon PostgreSQL)
