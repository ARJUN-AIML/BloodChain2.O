# ==============================================================================
# BloodChain Environment Configuration Template
# Copy this file to .env before starting the containers:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Backend Core Settings
# ------------------------------------------------------------------------------
# Secret key for cryptographic signing. Generate a strong key for production.
DJANGO_SECRET_KEY=django-insecure-replace-with-a-secure-random-key-in-production

# Enable debugging mode (True for development, False for production)
DEBUG=False

# Comma-separated list of allowed hostnames/IPs
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,*

# Port mapping for Backend API (Host:Container)
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Internal Docker PostgreSQL container credentials
POSTGRES_DB=bloodchain
POSTGRES_USER=bloodchain
POSTGRES_PASSWORD=bloodchain_secret_change_me_in_prod
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database connection URL:
# For local Docker PostgreSQL container (default):
DATABASE_URL=postgresql://bloodchain:bloodchain_secret_change_me_in_prod@db:5432/bloodchain
# For external Neon PostgreSQL cloud database (optional):
# DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<dbname>?sslmode=require

# Optional: Host port mapping to access PostgreSQL externally (e.g. via DBeaver/pgAdmin)
DB_PORT=5432

# ------------------------------------------------------------------------------
# 3. Frontend Web Application (React + Vite + Nginx)
# ------------------------------------------------------------------------------
# Port mapping for Frontend (Host:Container)
FRONTEND_PORT=3000

# API Base URL used by the frontend:
# Relative path '/api' is recommended because Nginx reverse-proxies /api to backend:8000
VITE_API_BASE_URL=/api

# Public URL for scanning and verifying QR code passes on mobile devices:
# In Local Dev: Set to your public HTTPS tunnel (e.g., https://your-tunnel.trycloudflare.com)
# In Production: Set to your production domain (e.g., https://bloodchain.org)
PUBLIC_APP_URL=http://localhost:3000
VITE_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Firebase Authentication & Cloud Database Credentials
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=bloodchain-95960
FIREBASE_API_KEY=AIzaSyDbMwrUoDEqMw_X4Rm_ss_bAzxRqdN1GuU
FIREBASE_AUTH_DOMAIN=bloodchain-95960.firebaseapp.com
FIREBASE_DATABASE_URL=https://bloodchain-95960-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_STORAGE_BUCKET=bloodchain-95960.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=836624051781

# Frontend Vite-prefixed Firebase credentials (inlined during frontend build)
VITE_FIREBASE_API_KEY=AIzaSyDbMwrUoDEqMw_X4Rm_ss_bAzxRqdN1GuU
VITE_FIREBASE_AUTH_DOMAIN=bloodchain-95960.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://bloodchain-95960-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=bloodchain-95960
VITE_FIREBASE_STORAGE_BUCKET=bloodchain-95960.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=836624051781
VITE_FIREBASE_APP_ID=1:836624051781:web:2ec7be72a04e317ab67d2c
VITE_FIREBASE_MEASUREMENT_ID=G-7ZNRYWT6Y1
